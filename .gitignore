# Environment configuration:
# .env.dev / .env.staging / .env.prod are COMMITTED on purpose: they are bundled
# into the app as assets (extractable from the APK), so they must never hold
# real secrets. Put per-developer overrides in .env.local (ignored).
.env.local

# Exceptions to ignore rules
!default.mode1v3
!default.mode2v3
!default.pbxuser
!default.perspectivev3
