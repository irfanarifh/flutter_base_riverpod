{
  "name": "flutter-base-project",
  "version": "1.0.0",
  "private": true,
  "description": "Script shortcuts for flutter-base-project",
  "scripts": {
    "dev": "flutter run --flavor dev",
    "staging": "flutter run --flavor staging",
    "prod": "flutter run --flavor prod",
    "start": "flutter run",
    "build": "flutter build apk --flavor prod",
    "build:dev": "flutter build apk --flavor dev",
    "build:staging": "flutter build apk --flavor staging",
    "build:prod": "flutter build apk --flavor prod",
    "build:aab": "flutter build appbundle --flavor prod",
    "build:ios": "flutter build ios --flavor prod",
    "build:ipa": "flutter build ipa --flavor prod",
    "codegen": "dart run tool/codegen.dart",
    "build-runner": "dart run build_runner build",
    "watch": "dart run build_runner watch",
    "l10n": "flutter gen-l10n",
    "icons": "dart run flutter_launcher_icons",
    "splash": "dart run flutter_native_splash:create",
    "feature": "dart run tool/new_feature.dart",
    "rename": "dart run tool/rename_project.dart",
    "get": "flutter pub get",
    "clean": "flutter clean",
    "clean:get": "flutter clean && flutter pub get",
    "fresh": "flutter clean && flutter pub get && dart run tool/codegen.dart",
    "lint": "flutter analyze",
    "analyze": "flutter analyze",
    "format": "dart format .",
    "format:fix": "dart format --fix .",
    "test": "flutter test",
    "test:coverage": "flutter test --coverage",
    "test:integration": "flutter test integration_test/app_test.dart",
    "check": "npm run format && npm run analyze && npm test"
  }
}

